{% extends 'base.html.twig' %}

{% block title %}{{'Question index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Question index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Text'|trans}}</th>
                <th>{{'Explication'|trans}}</th>
                <th>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for question in questions %}
            <tr>
                <td>{{ question.id }}</td>
                <td>{{ question.text }}</td>
                <td>{{ question.explication }}</td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': question, 'app_delete': 'app_question_delete','app_show': 'app_question_show','app_edit': 'app_question_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_question_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
