{% extends 'base.html.twig' %}

{% block title %}Question{% endblock %}

{% block body %}
    <h1>Question</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ question.id }}</td>
            </tr>
            <tr>
                <th>Text</th>
                <td>{{ question.text }}</td>
            </tr>
            <tr>
                <th>Explication</th>
                <td>{{ question.explication }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_question_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_question_edit', {'id': question.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('question/_delete_form.html.twig') }}
{% endblock %}
