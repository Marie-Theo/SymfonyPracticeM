{% extends 'base.html.twig' %}

{% block title %}{{'Credit'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Credit'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{'Id'|trans}}</th>
                <td>{{ credit.id }}</td>
            </tr>
            <tr>
                <th>{{'Author_name'|trans}}</th>
                <td>{{ credit.authorName }}</td>
            </tr>
            <tr>
                <th>{{'Source_url'|trans}}</th>
                <td><a href="{{ credit.sourceUrl }}" target="_blank">{{ credit.sourceUrl }}</a></td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_credit_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_credit_edit', {'id': credit.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('credit/_delete_form.html.twig') }}
{% endblock %}
