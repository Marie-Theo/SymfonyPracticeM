{% extends 'base.html.twig' %}

{% block title %}{{'Credit index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Credit index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Author_name'|trans}}</th>
                <th>{{'Source_url'|trans}}</th>
                <th style='text-align: center;'>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for credit in credits %}
            <tr>
                <td>{{ credit.id }}</td>
                <td>{{ credit.authorName }}</td>
                <td><a href="{{ credit.sourceUrl }}" target="_blank">{{ credit.sourceUrl }}</a></td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': credit, 'app_delete': 'app_credit_delete','app_show': 'app_credit_show','app_edit': 'app_credit_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_credit_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
