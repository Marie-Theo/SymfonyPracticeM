{% extends 'base.html.twig' %}

{% block title %}{{'User'|trans}}{% endblock %}

{% block body %}
    <h1>{{'User'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{'Id'|trans}}</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>{{'Email'|trans}}</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>{{'Roles'|trans}}</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>{{'IsVerified'|trans}}</th>
                <td>{{ user.isVerified ? 'Yes'|trans : 'No'|trans }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_user_edit', {'id': user.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
