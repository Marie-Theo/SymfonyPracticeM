{% extends "base.html.twig"%}
{% block title %}Quiz{% endblock %}
{% block body %}
{% if is_granted('ROLE_SUPER_ADMIN') %}
<h1>{{"Super Administrator page"|trans}}</h1>
Access CRUD + Dashboard (Stat)<br>
<button class="btn btn-primary">Tester</button>
{% elseif is_granted('ROLE_ADMIN')  %}
<h1>{{"Teacher page"|trans}}</h1>
Create session + see player + start when they want 
{% else %}
<h1>{{"User page"|trans}}</h1>
<div class="r-flex">
    <div>présentation</div>
    <form action="" class="d-flex flex-column align-content-center">
        <div class="col-auto">
            <label for="code-session" class="col-form-label">{{"Join session"|trans}}</label>
        </div>
        <div class="d-flex flex-row g-3">
            <div class="col-auto">
                <input type="text" id="codeSession" class="form-control">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">{{"Join"|trans}}</button>
            </div>
        </div>    
    </form>    
</div>
{% endif %}
{% endblock %}