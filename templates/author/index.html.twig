{% extends 'base.html.twig' %}

{% block title %}{{'Author index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Author index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Firstname'|trans}}</th>
                <th>{{'Name'|trans}}</th>
                <th>{{'Zip'|trans}}</th>
                <th>{{'Town'|trans}}</th>
                <th style='text-align: center;'>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for author in authors %}
            <tr>
                <td>{{ author.id }}</td>
                <td>{{ author.firstname }}</td>
                <td>{{ author.name }}</td>
                <td>{{ author.zip }}</td>
                <td>{{ author.town }}</td>
                <td align='center'>
                    <form class="btn-group" method="post" action="{{ path('app_author_delete', {'id': author.id}) }}" onsubmit="return confirm('{{'Are you sure you want to delete this item?'|trans}}');">
                        <a href="{{ path('app_author_show', {'id': author.id}) }}" class="btn btn btn-outline-info bt-sm" title="{{ 'show'|trans }}">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a href="{{ path('app_author_edit', {'id': author.id}) }}" class="btn btn-outline-warning bt-sm" title="{{ 'edit'|trans }}">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <button class="btn btn-outline-danger bt-sm" class="btn" title="{{'Delete'|trans}}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
                            <i class="fa-sharp fa-solid fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_author_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
