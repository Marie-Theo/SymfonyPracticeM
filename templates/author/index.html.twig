{% extends 'base.html.twig' %}

{% block title %}{{'Author index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Author index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Firstname'|trans}}</th>
                <th>{{'Name'|trans}}</th>
                <th>{{'Zip'|trans}}</th>
                <th>{{'Town'|trans}}</th>
                <th style='text-align: center;'>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for author in authors %}
            <tr>
                <td>{{ author.id }}</td>
                <td>{{ author.firstname }}</td>
                <td>{{ author.name }}</td>
                <td>{{ author.zip }}</td>
                <td>{{ author.town }}</td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': author, 'app_delete': 'app_author_delete','app_show': 'app_author_show','app_edit': 'app_author_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_author_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
