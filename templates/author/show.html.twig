{% extends 'base.html.twig' %}

{% block title %}{{'Author'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Author'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ author.id }}</td>
            </tr>
            <tr>
                <th>Firstname</th>
                <td>{{ author.firstname }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ author.name }}</td>
            </tr>
            <tr>
                <th>Zip</th>
                <td>{{ author.zip }}</td>
            </tr>
            <tr>
                <th>Town</th>
                <td>{{ author.town }}</td>
            </tr>
        </tbody>
    </table>
    
    <a href="{{ path('app_author_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_author_edit', {'id': author.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('author/_delete_form.html.twig') }}
{% endblock %}
