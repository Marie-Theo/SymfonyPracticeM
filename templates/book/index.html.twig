{% extends 'base.html.twig' %}

{% block title %}{{'Book index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Book index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Title'|trans}}</th>
                <th>{{'Nbrpages'|trans}}</th>
                <th style='text-align: center;'>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.nbrpages }}</td>
                <td align='center'>
                    <form class="btn-group" method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('{{'Are you sure you want to delete this item?'|trans}}');">
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn btn-outline-info bt-sm" title="{{ 'show'|trans }}">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-outline-warning bt-sm" title="{{ 'edit'|trans }}">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <button class="btn btn-outline-danger bt-sm" class="btn" title="{{'Delete'|trans}}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                            <i class="fa-sharp fa-solid fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_book_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
