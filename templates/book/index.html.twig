{% extends 'base.html.twig' %}

{% block title %}{{'Book index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Book index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Title'|trans}}</th>
                <th>{{'Nbrpages'|trans}}</th>
                <th style='text-align: center;'>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.nbrpages }}</td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': book, 'app_delete': 'app_book_delete','app_show': 'app_book_show','app_edit': 'app_book_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_book_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
