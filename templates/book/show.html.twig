{% extends 'base.html.twig' %}

{% block title %}{{'Book'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Book'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{'Id'|trans}}</th>
                <td>{{ book.id }}</td>
            </tr>
            <tr>
                <th>{{'Title'|trans}}</th>
                <td>{{ book.title }}</td>
            </tr>
            <tr>
                <th>{{'Nbrpages'|trans}}</th>
                <td>{{ book.nbrpages }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_book_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_book_edit', {'id': book.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('book/_delete_form.html.twig') }}
{% endblock %}
