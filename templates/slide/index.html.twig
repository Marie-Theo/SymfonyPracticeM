{% extends 'base.html.twig' %}

{% block title %}{{"Slide index"|trans}}{% endblock %}

{% block body %}
    <h1>{{"Slide index"|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{"Id"|trans}}</th>
                <th>{{"Title"|trans}}</th>
                <th>{{"Description"|trans}}</th>
                <th>{{"Content"|trans}}</th>
                <th>{{"Position"|trans}}</th>
                <th>{{"actions"|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for slide in slides %}
            <tr>
                <td>{{ slide.id }}</td>
                <td>{{ slide.title }}</td>
                <td>{{ slide.description }}</td>
                <td>{{ slide.content }}</td>
                <td>{{ slide.position }}</td>
                <td  align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': slide, 'app_delete': 'app_slide_delete','app_show': 'app_slide_show','app_edit': 'app_slide_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{"no records found"|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_slide_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
