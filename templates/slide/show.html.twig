{% extends 'base.html.twig' %}

{% block title %}{{"Slide"|trans}}{% endblock %}

{% block body %}
    <h1>{{"Slide"|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{"Id"|trans}}</th>
                <td>{{ slide.id }}</td>
            </tr>
            <tr>
                <th>{{"Title"|trans}}</th>
                <td>{{ slide.title }}</td>
            </tr>
            <tr>
                <th>{{"Description"|trans}}</th>
                <td>{{ slide.description }}</td>
            </tr>
            <tr>
                <th>{{"Position"|trans}}</th>
                <td>{{ slide.position }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_slide_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_slide_edit', {'id': slide.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('slide/_delete_form.html.twig') }}
{% endblock %}
