{% extends 'base.html.twig' %}

{% block title %}{{'Country'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Country'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ country.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ country.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_country_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_country_edit', {'id': country.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('country/_delete_form.html.twig') }}
{% endblock %}
