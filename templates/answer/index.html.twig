{% extends 'base.html.twig' %}

{% block title %}{{'Answer index'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Answer index'|trans}}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{'Id'|trans}}</th>
                <th>{{'Text'|trans}}</th>
                <th>{{'Is_correct'|trans}}</th>
                <th>{{'actions'|trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for answer in answers %}
            <tr>
                <td>{{ answer.id }}</td>
                <td>{{ answer.text }}</td>
                <td>{{ answer.isCorrect ? 'Yes' : 'No' }}</td>
                <td align='center'>
                    {{ include('actions/_action_form.html.twig', {'object': answer, 'app_delete': 'app_answer_delete','app_show': 'app_answer_show','app_edit': 'app_answer_edit'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">{{'no records found'|trans}}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_answer_new') }}"><button class="btn btn-primary">{{'Create new'|trans}}</button></a>
{% endblock %}
