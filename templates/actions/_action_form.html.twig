
{% if app_delete is defined %}
    <form class="btn-group" method="post" action="{{ path(app_delete, {'id': object.id}) }}" onsubmit="return confirm('{{'Are you sure you want to delete this item?'|trans}}');">
{% else %}
    <div class="btn-group">
{% endif %}
    {% if app_show is defined %}
        <a href="{{ path(app_show, {'id': object.id}) }}" class="btn btn btn-outline-info bt-sm" title="{{ 'show'|trans }}">
            <i class="fa-solid fa-eye"></i>
        </a>
    {% endif %}
    {% if app_edit is defined %}
        <a href="{{ path(app_edit, {'id': object.id}) }}" class="btn btn-outline-warning bt-sm" title="{{ 'edit'|trans }}">
            <i class="fa-solid fa-pen"></i>
        </a>
    {% endif %}
    {% if app_delete is defined %}
        <button class="btn btn-outline-danger bt-sm" class="btn" title="{{'Delete'|trans}}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ object.id) }}">
            <i class="fa-sharp fa-solid fa-trash"></i>
        </button>
    {% endif %}
{% if app_delete is defined %}
    </form>
{% else %}
    </div>
{% endif %}