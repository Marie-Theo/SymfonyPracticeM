{% extends 'base.html.twig' %}

{% block title %}{{'Image'|trans}}{% endblock %}

{% block body %}
    <h1>{{'Image'|trans}}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{'Id'|trans}}</th>
                <td>{{ image.id }}</td>
            </tr>
            <tr>
                <th>{{'Image'|trans}}</th>
                <td><img src='/images/{{ image.path }}' height="100" /></td>
            </tr>
            <tr>
                <th>{{'Path'|trans}}</th>
                <td>{{ image.path }}</td>
            </tr>
            <tr>
                <th>{{'Author Name'|trans}}</th>
                <td>
                    {% for credit in image.credits %}
                        <a href="{{ credit.sourceUrl }}" target="_blank">{{ credit.authorName }}</a>
                    {% endfor %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_image_index') }}"><button class="btn btn-primary">{{'back to list'|trans}}</button></a>

    <a href="{{ path('app_image_edit', {'id': image.id}) }}"><button class="btn btn-info">{{'edit'|trans}}</button></a>

    {{ include('image/_delete_form.html.twig') }}
{% endblock %}
